# Copy this file to `.env` and fill in the values.
# `.env` is never committed; this file only documents which variables are required.

# Port Nest listens on (defaults to 3000)
BACKEND_PORT=3000

# Origin allowed by CORS (the Vite frontend URL)
FRONTEND_URL=http://localhost:5173

# Credentials for the local Postgres started by docker-compose.yml
DB_USER=askuae
DB_PASSWORD=change_me
DB_NAME=askuae

# Connection string used by Prisma and `pg`. Must match the values above.
# Port 5444 is the one docker-compose exposes on your machine.
DATABASE_URL=postgresql://askuae:change_me@localhost:5444/askuae?schema=public

# Firebase project ID, used to verify ID tokens (Firebase console → Project settings)
FIREBASE_PROJECT_ID=your-firebase-project-id