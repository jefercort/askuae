# Copia este archivo como `.env` y rellena los valores.
# `.env` nunca se commitea; este archivo solo documenta qué variables se necesitan.

# Puerto donde escucha Nest (por defecto 3000)
BACKEND_PORT=3000

# Origen permitido por CORS (la URL del frontend de Vite)
FRONTEND_URL=http://localhost:5173

# Credenciales del Postgres local que levanta docker-compose.yml
DB_USER=askuae
DB_PASSWORD=change_me
DB_NAME=askuae

# Conexión que usan Prisma y `pg`. Debe coincidir con los valores de arriba.
# El puerto 5444 es el que expone docker-compose en tu PC.
DATABASE_URL=postgresql://askuae:change_me@localhost:5444/askuae?schema=public
