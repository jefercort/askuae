generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  GOOGLE
  MICROSOFT
  APPLE
  EMAIL
}

enum Role {
  USER
  ADMIN
}

enum City {
  ABU_DHABI
  DUBAI
  SHARJAH
  AJMAN
  UMM_AL_QUWAIN
  RAS_AL_KHAIMAH
  FUJAIRAH
}

model User {
  id               String            @id @default(uuid()) @db.Uuid
  firebaseUid      String            @unique @db.VarChar(255)
  nameUser         String            @db.VarChar(255)
  emailUser        String            @unique @db.VarChar(255)
  role             Role              @default(USER)
  profileImg       String?           @db.VarChar(255)
  authProvider     AuthProvider
  createdAt        DateTime          @default(now()) @db.Timestamptz()
  reviews          Review[]
  serviceProviders ServiceProvider[]
}

model ServiceProvider {
  id               String            @id @default(uuid()) @db.Uuid
  userId           String?           @db.Uuid
  name             String            @db.VarChar(255)
  email            String?           @db.VarChar(255)
  phone1           String?           @db.VarChar(255)
  phone2           String?           @db.VarChar(255)
  wp1              Boolean           @default(false)
  wp2              Boolean           @default(false)
  tg1              Boolean           @default(false)
  tg2              Boolean           @default(false)
  instaUrl         String?           @db.VarChar(255)
  tiktokUrl        String?           @db.VarChar(255)
  websiteUrl       String?           @db.VarChar(255)
  city             City
  address          String?           @db.VarChar(255)
  rating           Decimal?          @db.Decimal(2, 1)
  reviewCount      Int               @default(0)
  mapsUrl          String?           @db.VarChar(2048)
  reviews          Review[]
  serviceOfferings ServiceOffering[]

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model ServiceOffering {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(255)
  categoryId  String   @db.Uuid
  providerId  String   @db.Uuid
  price       Decimal? @db.Decimal(10, 2)
  description String   @db.Text

  category ServiceCategory @relation(fields: [categoryId], references: [id])
  provider ServiceProvider @relation(fields: [providerId], references: [id])
}

model ServiceCategory {
  id               String            @id @default(uuid()) @db.Uuid
  name             String            @unique @db.VarChar(255)
  icon             String            @db.VarChar(255)
  serviceOfferings ServiceOffering[]
}

model Review {
  id         Int      @id @default(autoincrement())
  rating     Decimal  @db.Decimal(2, 1)
  autorId    String   @db.Uuid
  providerId String   @db.Uuid
  comment    String   @db.Text
  createdAt  DateTime @default(now()) @db.Timestamptz()

  autor    User            @relation(fields: [autorId], references: [id])
  provider ServiceProvider @relation(fields: [providerId], references: [id])
}
